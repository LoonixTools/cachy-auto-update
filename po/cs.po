msgid "The update was stopped before it finished."
msgstr "Aktualizace byla zastavena před dokončením."

msgid "Finishing an interrupted update"
msgstr "Dokončování přerušené aktualizace"

msgid "The last update was cut short, most likely because the machine was switched off. It is being finished now."
msgstr "Poslední aktualizace byla přerušena, nejspíš proto, že se počítač vypnul. Teď se dokončuje."

msgid "Package database locked"
msgstr "Databáze balíčků je zamčená"

msgid "pacman's lock file looks left over from an interrupted update. Updates are paused until it is cleared."
msgstr "Zámek pacmanu vypadá jako pozůstatek přerušené aktualizace. Aktualizace jsou pozastavené, dokud nebude odstraněn."

msgid "Update failed"
msgstr "Aktualizace selhala"

msgid "Something went wrong while updating. Run 'cachy-auto-update log' for details."
msgstr "Během aktualizace se něco pokazilo. Podrobnosti ukáže 'cachy-auto-update log'."

msgid "Update stopped"
msgstr "Aktualizace zastavena"

msgid "You can switch off the computer now. The update will run again later."
msgstr "Teď můžete počítač vypnout. Aktualizace se později spustí znovu."

msgid "System updated"
msgstr "Systém aktualizován"

#, c-format
msgid "%d updates were installed."
msgstr "Nainstalované aktualizace: %d."

msgid "Some packages were held back"
msgstr "Některé balíčky byly podrženy"

#, c-format
msgid "%s could not be updated and was skipped. Everything else is up to date."
msgstr "%s nešel aktualizovat a byl přeskočen. Vše ostatní je aktuální."

msgid "This command has to run as root."
msgstr "Tento příkaz musí běžet jako root."

msgid "Could not write the configuration file."
msgstr "Nepodařilo se zapsat soubor s nastavením."

msgid "/etc/sudoers.d/cachy-auto-update is invalid; refusing to enable."
msgstr "/etc/sudoers.d/cachy-auto-update je neplatný; zapnutí odmítnuto."

msgid "Could not enable the systemd timer."
msgstr "Nepodařilo se zapnout časovač systemd."

msgid "Automatic updates are on."
msgstr "Automatické aktualizace jsou zapnuté."

msgid "No AUR helper found. Install paru or yay for AUR updates."
msgstr "Nenalezen žádný pomocník AUR. Pro aktualizace AUR nainstalujte paru nebo yay."

msgid "base-devel is missing, so AUR packages cannot be built."
msgstr "Chybí base-devel, takže balíčky AUR nejde sestavit."

msgid "Automatic updates are off."
msgstr "Automatické aktualizace jsou vypnuté."

msgid "Notifications are on."
msgstr "Oznámení jsou zapnutá."

msgid "Notifications are off."
msgstr "Oznámení jsou vypnutá."

msgid "Usage: cachy-auto-update notifications on|off"
msgstr "Použití: cachy-auto-update notifications on|off"

msgid "Usage: cachy-auto-update config [list | get KEY | set KEY VALUE]"
msgstr "Použití: cachy-auto-update config [list | get KLÍČ | set KLÍČ HODNOTA]"

