msgstr "Melyik napló"

msgid "Restart"
msgstr "Újraindítás"

msgid "Restart automatically"
msgstr "Automatikus újraindítás"

msgid "Only while nobody is logged in, and never after a failed update."
msgstr "Csak ha senki sincs bejelentkezve, és sosem sikertelen frissítés után."

msgid "Never"
msgstr "Soha"

msgid "After a kernel update"
msgstr "Kernelfrissítés után"

msgid "After every update"
msgstr "Minden frissítés után"

msgid "A restart is planned to finish the update."
msgstr "A frissítés befejezéséhez újraindítás van tervezve."

msgid "It happens by itself once nobody is logged in."
msgstr "Magától megtörténik, ha senki sincs bejelentkezve."

#, c-format
