msgid "The update was stopped before it finished."
msgstr "A frissítés leállt, mielőtt befejeződött."

msgid "Finishing an interrupted update"
msgstr "Megszakadt frissítés befejezése"

msgid "The last update was cut short, most likely because the machine was switched off. It is being finished now."
msgstr "Az utolsó frissítés megszakadt, valószínűleg mert a gépet kikapcsolták. Most fejeződik be."

msgid "Package database locked"
msgstr "A csomagadatbázis zárolva"

msgid "pacman's lock file looks left over from an interrupted update. Updates are paused until it is cleared."
msgstr "A pacman zárolási fájlja egy megszakadt frissítés maradványának tűnik. A frissítések szünetelnek, amíg el nem távolítják."

msgid "Update failed"
msgstr "Sikertelen frissítés"

msgid "Something went wrong while updating. Run 'cachy-auto-update log' for details."
msgstr "Hiba történt a frissítés közben. A részletekért futtassa: 'cachy-auto-update log'."

msgid "Update stopped"
msgstr "A frissítés leállt"

msgid "You can switch off the computer now. The update will run again later."
msgstr "Most már kikapcsolhatja a számítógépet. A frissítés később újra lefut."

msgid "System updated"
msgstr "A rendszer frissítve"

#, c-format
msgid "%d updates were installed."
msgstr "%d frissítés települt."

msgid "Some packages were held back"
msgstr "Néhány csomag visszatartva"

#, c-format
msgid "%s could not be updated and was skipped. Everything else is up to date."
msgstr "A(z) %s nem frissíthető, ezért kimaradt. Minden más naprakész."

msgid "This command has to run as root."
msgstr "Ezt a parancsot rootként kell futtatni."

msgid "Could not write the configuration file."
msgstr "Nem sikerült írni a beállítófájlt."

msgid "/etc/sudoers.d/cachy-auto-update is invalid; refusing to enable."
msgstr "Az /etc/sudoers.d/cachy-auto-update érvénytelen; a bekapcsolás elutasítva."

msgid "Could not enable the systemd timer."
msgstr "Nem sikerült bekapcsolni a systemd időzítőt."

msgid "Automatic updates are on."
msgstr "Az automatikus frissítések be vannak kapcsolva."

msgid "No AUR helper found. Install paru or yay for AUR updates."
msgstr "Nem található AUR-segéd. Az AUR-frissítésekhez telepítse a paru vagy a yay programot."

msgid "base-devel is missing, so AUR packages cannot be built."
msgstr "Hiányzik a base-devel, így az AUR-csomagok nem építhetők."

msgid "Automatic updates are off."
msgstr "Az automatikus frissítések ki vannak kapcsolva."

msgid "Notifications are on."
msgstr "Az értesítések be vannak kapcsolva."

msgid "Notifications are off."
msgstr "Az értesítések ki vannak kapcsolva."

msgid "Usage: cachy-auto-update notifications on|off"
msgstr "Használat: cachy-auto-update notifications on|off"

