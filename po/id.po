msgid "The update was stopped before it finished."
msgstr "Pembaruan dihentikan sebelum selesai."

msgid "Finishing an interrupted update"
msgstr "Menyelesaikan pembaruan yang terputus"

msgid "The last update was cut short, most likely because the machine was switched off. It is being finished now."
msgstr "Pembaruan terakhir terputus, kemungkinan karena komputer dimatikan. Sekarang sedang diselesaikan."

msgid "Package database locked"
msgstr "Basis data paket terkunci"

msgid "pacman's lock file looks left over from an interrupted update. Updates are paused until it is cleared."
msgstr "Berkas kunci pacman tampaknya sisa dari pembaruan yang terputus. Pembaruan dijeda sampai berkas itu dihapus."

msgid "Update failed"
msgstr "Pembaruan gagal"

msgid "Something went wrong while updating. Run 'cachy-auto-update log' for details."
msgstr "Terjadi masalah saat memperbarui. Jalankan 'cachy-auto-update log' untuk detailnya."

msgid "Update stopped"
msgstr "Pembaruan dihentikan"

msgid "You can switch off the computer now. The update will run again later."
msgstr "Anda bisa mematikan komputer sekarang. Pembaruan akan berjalan lagi nanti."

msgid "System updated"
msgstr "Sistem diperbarui"

#, c-format
msgid "%d updates were installed."
msgstr "%d pembaruan telah dipasang."

msgid "Some packages were held back"
msgstr "Beberapa paket ditahan"

#, c-format
msgid "%s could not be updated and was skipped. Everything else is up to date."
msgstr "%s tidak bisa diperbarui dan dilewati. Semua yang lain sudah terbaru."

msgid "This command has to run as root."
msgstr "Perintah ini harus dijalankan sebagai root."

msgid "Could not write the configuration file."
msgstr "Tidak bisa menulis berkas konfigurasi."

msgid "/etc/sudoers.d/cachy-auto-update is invalid; refusing to enable."
msgstr "/etc/sudoers.d/cachy-auto-update tidak valid; menolak untuk mengaktifkan."

msgid "Could not enable the systemd timer."
msgstr "Tidak bisa mengaktifkan timer systemd."

msgid "Automatic updates are on."
msgstr "Pembaruan otomatis menyala."

msgid "No AUR helper found. Install paru or yay for AUR updates."
msgstr "Pembantu AUR tidak ditemukan. Pasang paru atau yay untuk pembaruan AUR."

msgid "base-devel is missing, so AUR packages cannot be built."
msgstr "base-devel tidak ada, jadi paket AUR tidak bisa dibangun."

msgid "Automatic updates are off."
msgstr "Pembaruan otomatis mati."

msgid "Notifications are on."
msgstr "Notifikasi menyala."

msgid "Notifications are off."
msgstr "Notifikasi mati."

msgid "Usage: cachy-auto-update notifications on|off"
msgstr "Penggunaan: cachy-auto-update notifications on|off"

msgid "Usage: cachy-auto-update config [list | get KEY | set KEY VALUE]"
msgstr "Penggunaan: cachy-auto-update config [list | get KUNCI | set KUNCI NILAI]"

