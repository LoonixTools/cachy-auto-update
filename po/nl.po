msgid "%d updates were installed."
msgstr "Er zijn %d updates geïnstalleerd."

msgid "Some packages were held back"
msgstr "Sommige pakketten zijn tegengehouden"

#, c-format
msgid "%s could not be updated and was skipped. Everything else is up to date."
msgstr "%s kon niet worden bijgewerkt en is overgeslagen. Al het andere is bijgewerkt."

msgid "This command has to run as root."
msgstr "Deze opdracht moet als root worden uitgevoerd."

msgid "Could not write the configuration file."
msgstr "Kon het configuratiebestand niet schrijven."

