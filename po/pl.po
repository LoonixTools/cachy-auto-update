msgid "Automatic updates"
msgstr "Automatyczne aktualizacje"

msgid "Notifications"
msgstr "Powiadomienia"

msgid "Show an icon in the system tray"
msgstr "Pokazuj ikonę w zasobniku systemowym"

msgid "Also run cachy-update"
msgstr "Uruchamiaj też cachy-update"

msgid "Show the CachyOS restart notice"
msgstr "Pokazuj powiadomienie CachyOS o ponownym uruchomieniu"

