msgstr "Wstrzymanie po zakończeniu bieżącego kroku"

msgid "Stopping the update"
msgstr "Zatrzymywanie aktualizacji"

msgid "The current step is finished first. Please leave the computer switched on until then."
msgstr "Najpierw zostanie dokończony bieżący krok. Do tego czasu nie wyłączaj komputera."

msgid "Log"
msgstr "Dziennik"

msgid "never"
msgstr "nigdy"

msgid "just now"
msgstr "przed chwilą"

