msgid "The update was stopped before it finished."
msgstr "Aktualizacja została zatrzymana przed końcem."

msgid "Finishing an interrupted update"
msgstr "Kończenie przerwanej aktualizacji"

msgid "The last update was cut short, most likely because the machine was switched off. It is being finished now."
msgstr "Ostatnia aktualizacja została przerwana, najpewniej przez wyłączenie komputera. Teraz jest kończona."

msgid "Package database locked"
msgstr "Baza danych pakietów zablokowana"

msgid "pacman's lock file looks left over from an interrupted update. Updates are paused until it is cleared."
msgstr "Plik blokady pacmana wygląda na pozostałość po przerwanej aktualizacji. Aktualizacje są wstrzymane, dopóki nie zostanie usunięty."

msgid "Update failed"
msgstr "Aktualizacja nie powiodła się"

msgid "Something went wrong while updating. Run 'cachy-auto-update log' for details."
msgstr "Podczas aktualizacji coś poszło nie tak. Uruchom 'cachy-auto-update log', aby zobaczyć szczegóły."

msgid "Update stopped"
msgstr "Aktualizacja zatrzymana"

msgid "You can switch off the computer now. The update will run again later."
msgstr "Możesz teraz wyłączyć komputer. Aktualizacja uruchomi się ponownie później."

msgid "System updated"
msgstr "System zaktualizowany"

#, c-format
msgid "%d updates were installed."
msgstr "Zainstalowane aktualizacje: %d."

msgid "Some packages were held back"
msgstr "Niektóre pakiety zostały wstrzymane"

#, c-format
msgid "%s could not be updated and was skipped. Everything else is up to date."
msgstr "Nie udało się zaktualizować %s, więc pominięto. Cała reszta jest aktualna."

msgid "This command has to run as root."
msgstr "To polecenie trzeba uruchomić jako root."

msgid "Could not write the configuration file."
msgstr "Nie udało się zapisać pliku konfiguracji."

msgid "/etc/sudoers.d/cachy-auto-update is invalid; refusing to enable."
msgstr "/etc/sudoers.d/cachy-auto-update jest nieprawidłowy; odmowa włączenia."

msgid "Could not enable the systemd timer."
msgstr "Nie udało się włączyć licznika systemd."

msgid "Automatic updates are on."
msgstr "Automatyczne aktualizacje są włączone."

msgid "No AUR helper found. Install paru or yay for AUR updates."
msgstr "Nie znaleziono pomocnika AUR. Zainstaluj paru lub yay, aby aktualizować AUR."

msgid "base-devel is missing, so AUR packages cannot be built."
msgstr "Brak base-devel, więc nie można budować pakietów AUR."

msgid "Automatic updates are off."
msgstr "Automatyczne aktualizacje są wyłączone."

msgid "Notifications are on."
msgstr "Powiadomienia są włączone."

msgid "Notifications are off."
msgstr "Powiadomienia są wyłączone."

msgid "Usage: cachy-auto-update notifications on|off"
msgstr "Użycie: cachy-auto-update notifications on|off"

msgid "Usage: cachy-auto-update config [list | get KEY | set KEY VALUE]"
msgstr "Użycie: cachy-auto-update config [list | get KLUCZ | set KLUCZ WARTOŚĆ]"

msgid "OFF"
msgstr "WYŁ."

msgid "How often"
msgstr "Jak często"

msgid "Last check"
msgstr "Ostatnie sprawdzenie"

