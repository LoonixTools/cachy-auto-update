msgid "%s could not be updated and was skipped. Everything else is up to date."
msgstr "%s kunde inte uppdateras och hoppades över. Allt annat är uppdaterat."

msgid "This command has to run as root."
msgstr "Det här kommandot måste köras som root."

msgid "Could not write the configuration file."
msgstr "Kunde inte skriva konfigurationsfilen."

msgid "/etc/sudoers.d/cachy-auto-update is invalid; refusing to enable."
msgstr "/etc/sudoers.d/cachy-auto-update är ogiltig; vägrar aktivera."

msgid "Could not enable the systemd timer."
msgstr "Kunde inte aktivera systemd-timern."

msgid "Automatic updates are on."
msgstr "Automatiska uppdateringar är på."

msgid "No AUR helper found. Install paru or yay for AUR updates."
msgstr "Ingen AUR-hjälpare hittades. Installera paru eller yay för AUR-uppdateringar."

msgid "base-devel is missing, so AUR packages cannot be built."
msgstr "base-devel saknas, så AUR-paket kan inte byggas."

