msgid "The update was stopped before it finished."
msgstr "Uppdateringen stoppades innan den var klar."

msgid "Finishing an interrupted update"
msgstr "Avslutar en avbruten uppdatering"

msgid "The last update was cut short, most likely because the machine was switched off. It is being finished now."
msgstr "Den senaste uppdateringen avbröts, troligen för att datorn stängdes av. Den avslutas nu."

msgid "Package database locked"
msgstr "Paketdatabasen är låst"

msgid "pacman's lock file looks left over from an interrupted update. Updates are paused until it is cleared."
msgstr "pacmans låsfil verkar vara kvar från en avbruten uppdatering. Uppdateringar är pausade tills den tas bort."

msgid "Update failed"
msgstr "Uppdateringen misslyckades"

msgid "Something went wrong while updating. Run 'cachy-auto-update log' for details."
msgstr "Något gick fel under uppdateringen. Kör 'cachy-auto-update log' för detaljer."

msgid "Update stopped"
msgstr "Uppdateringen stoppad"

msgid "You can switch off the computer now. The update will run again later."
msgstr "Du kan stänga av datorn nu. Uppdateringen körs igen senare."

msgid "System updated"
msgstr "Systemet uppdaterat"

#, c-format
msgid "%d updates were installed."
msgstr "%d uppdateringar installerades."

msgid "Some packages were held back"
msgstr "Vissa paket hölls tillbaka"

