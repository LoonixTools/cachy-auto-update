msgstr "Журналу ще немає."

msgid "Usage: cachy-auto-update [command]"
msgstr "Використання: cachy-auto-update [команда]"

msgid "Commands:"
msgstr "Команди:"

msgid "Without a command the window opens."
msgstr "Без команди відкривається вікно."

#, c-format
msgid "Unknown command: %s"
msgstr "Невідома команда: %s"

msgid "Turn automatic updates on"
msgstr "Увімкнути автоматичні оновлення"

msgid "Turn automatic updates off"
msgstr "Вимкнути автоматичні оновлення"

msgid "Turn desktop notifications on or off"
msgstr "Увімкнути або вимкнути сповіщення на стільниці"

msgid "Show the current state and conditions"
msgstr "Показати поточний стан і умови"

