msgid "%d packages are being updated. Please leave the computer switched on until this is done."
msgstr "Оновлюється пакунків: %d. Не вимикайте комп'ютер до завершення."

msgid "Updating AUR packages"
msgstr "Оновлення пакунків AUR"

msgid "Updating Flatpak apps"
msgstr "Оновлення програм Flatpak"

msgid "Updating AppImages"
msgstr "Оновлення AppImage"

