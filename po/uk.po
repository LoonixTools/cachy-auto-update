msgstr "невідомо"

msgid "Next scheduled run"
msgstr "Наступний запланований запуск"

msgid "The last run reported a problem. See 'cachy-auto-update log'."
msgstr "Останній запуск повідомив про проблему. Див. 'cachy-auto-update log'."

msgid "The last run was stopped before it finished."
msgstr "Останній запуск зупинено до завершення."

msgid "The last run was cancelled. It will run again later."
msgstr "Останній запуск скасовано. Він повториться пізніше."

msgid "A restart is recommended to finish a kernel update."
msgstr "Рекомендовано перезапуск, щоб завершити оновлення ядра."

#, c-format
msgid "Held back: %s"
msgstr "Затримано: %s"

msgid "Current conditions:"
msgstr "Поточні умови:"

