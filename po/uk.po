msgid "ON"
msgstr "УВІМК"

#, c-format
msgid "Unknown setting: %s"
msgstr "Невідомий параметр: %s"

#, c-format
msgid "Not a valid value for %s: %s"
msgstr "Недійсне значення для %s: %s"

msgid "Automatic updates"
msgstr "Автоматичні оновлення"

msgid "Notifications"
msgstr "Сповіщення"

msgid "Show an icon in the system tray"
msgstr "Показувати значок у системному лотку"

msgid "Also run cachy-update"
msgstr "Також запускати cachy-update"

msgid "Show the CachyOS restart notice"
msgstr "Показувати сповіщення CachyOS про перезапуск"

msgid "Notify when an update starts"
msgstr "Повідомляти про початок оновлення"

msgid "Start the progress bar minimized"
msgstr "Запускати індикатор поступу згорнутим"

msgid "Notify after a successful update"
msgstr "Повідомляти про успішне оновлення"

msgid "Notify when something goes wrong"
msgstr "Повідомляти, коли щось пішло не так"

msgid "Postpone while a game is running"
msgstr "Відкладати, поки запущена гра"

msgid "Only update on mains power"
msgstr "Оновлювати лише від мережі"

msgid "Update AUR packages"
msgstr "Оновлювати пакунки AUR"

msgid "Update Flatpaks"
msgstr "Оновлювати Flatpak"

msgid "Update AppImages"
msgstr "Оновлювати AppImage"

msgid "Also rebuild -git packages"
msgstr "Також перезбирати пакунки -git"

msgid "AUR helper"
msgstr "Помічник AUR"

msgid "Resolve package conflicts automatically"
msgstr "Автоматично розв'язувати конфлікти пакунків"

msgid "Trim the package cache"
msgstr "Скорочувати кеш пакунків"

msgid "Clean the AUR build caches"
msgstr "Очищати кеші збирання AUR"

msgid "Remove packages nothing needs any more"
msgstr "Вилучати пакунки, які більше нічому не потрібні"

msgid "Never update these packages"
msgstr "Ніколи не оновлювати ці пакунки"

msgid "running on battery"
msgstr "робота від батареї"

#, c-format
msgid "battery at %d%%, below the %d%% threshold"
msgstr "заряд батареї %d%%, нижче порогу %d%%"

msgid "a game is running (GameMode)"
msgstr "запущено гру (GameMode)"

#, c-format
msgid "a game is running (%s)"
msgstr "запущено гру (%s)"

msgid "an application is blocking idle (fullscreen game or video)"
msgstr "програма блокує простій (гра або відео на весь екран)"

msgid "pacman's database is locked by another process"
msgstr "базу даних pacman заблоковано іншим процесом"

#, c-format
msgid "%s is currently running"
msgstr "зараз працює %s"

msgid "Pausing once the current step is done"
msgstr "Пауза після завершення поточного кроку"

msgid "Stopping the update"
msgstr "Зупинка оновлення"

msgid "The current step is finished first. Please leave the computer switched on until then."
msgstr "Спершу завершиться поточний крок. Не вимикайте комп'ютер до того часу."

msgid "Log"
msgstr "Журнал"

msgid "never"
msgstr "ніколи"

msgid "just now"
msgstr "щойно"

msgid "1 minute ago"
msgstr "1 хв тому"

#, c-format
msgid "%d minutes ago"
msgstr "%d хв тому"

msgid "1 hour ago"
msgstr "1 год тому"

#, c-format
msgid "%d hours ago"
msgstr "%d год тому"

msgid "1 day ago"
msgstr "1 дн. тому"

#, c-format
msgid "%d days ago"
msgstr "%d дн. тому"

msgid "every minute"
msgstr "щохвилини"

#, c-format
msgid "every %d minutes"
msgstr "кожні %d хв"

msgid "every hour"
msgstr "щогодини"

#, c-format
msgid "every %d hours"
msgstr "кожні %d год"

msgid "every day"
msgstr "щодня"

#, c-format
msgid "every %d days"
msgstr "кожні %d дн."

msgid "every week"
msgstr "щотижня"

#, c-format
msgid "every %d weeks"
msgstr "кожні %d тиж."

msgid "The update was stopped before it finished."
msgstr "Оновлення зупинено до завершення."

msgid "Finishing an interrupted update"
msgstr "Завершення перерваного оновлення"

msgid "The last update was cut short, most likely because the machine was switched off. It is being finished now."
msgstr "Останнє оновлення було перерване, найімовірніше, через вимкнення комп'ютера. Зараз воно завершується."

msgid "Package database locked"
msgstr "Базу даних пакунків заблоковано"

msgid "pacman's lock file looks left over from an interrupted update. Updates are paused until it is cleared."
msgstr "Файл блокування pacman, схоже, залишився від перерваного оновлення. Оновлення призупинено, доки його не буде вилучено."

msgid "Update failed"
msgstr "Помилка оновлення"

msgid "Something went wrong while updating. Run 'cachy-auto-update log' for details."
msgstr "Під час оновлення щось пішло не так. Подробиці: 'cachy-auto-update log'."

msgid "Update stopped"
msgstr "Оновлення зупинено"

msgid "You can switch off the computer now. The update will run again later."
msgstr "Тепер можна вимкнути комп'ютер. Оновлення запуститься пізніше знову."

msgid "System updated"
msgstr "Систему оновлено"

#, c-format
msgid "%d updates were installed."
msgstr "Встановлено оновлень: %d."

msgid "Some packages were held back"
msgstr "Деякі пакунки затримано"

#, c-format
msgid "%s could not be updated and was skipped. Everything else is up to date."
msgstr "Не вдалося оновити %s, його пропущено. Усе інше оновлено."

msgid "This command has to run as root."
msgstr "Цю команду треба запускати від root."

msgid "Could not write the configuration file."
msgstr "Не вдалося записати файл налаштувань."

msgid "/etc/sudoers.d/cachy-auto-update is invalid; refusing to enable."
msgstr "/etc/sudoers.d/cachy-auto-update недійсний; увімкнення скасовано."

msgid "Could not enable the systemd timer."
msgstr "Не вдалося увімкнути таймер systemd."

msgid "Automatic updates are on."
msgstr "Автоматичні оновлення увімкнено."

msgid "No AUR helper found. Install paru or yay for AUR updates."
msgstr "Помічника AUR не знайдено. Встановіть paru або yay для оновлень AUR."

msgid "base-devel is missing, so AUR packages cannot be built."
msgstr "Немає base-devel, тому пакунки AUR не можна зібрати."

msgid "Automatic updates are off."
msgstr "Автоматичні оновлення вимкнено."

msgid "Notifications are on."
msgstr "Сповіщення увімкнено."

msgid "Notifications are off."
msgstr "Сповіщення вимкнено."

msgid "Usage: cachy-auto-update notifications on|off"
msgstr "Використання: cachy-auto-update notifications on|off"

msgid "Usage: cachy-auto-update config [list | get KEY | set KEY VALUE]"
msgstr "Використання: cachy-auto-update config [list | get КЛЮЧ | set КЛЮЧ ЗНАЧЕННЯ]"

msgid "OFF"
msgstr "ВИМК"

msgid "How often"
msgstr "Як часто"

msgid "Last check"
msgstr "Остання перевірка"

msgid "Last successful update"
msgstr "Останнє успішне оновлення"

