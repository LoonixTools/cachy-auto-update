msgid "on battery (%d%%, threshold %d%%)"
msgstr "від батареї (%d%%, поріг %d%%)"

msgid "on battery"
msgstr "від батареї"

msgid "no game detected"
msgstr "ігор не виявлено"

msgid "package system is free"
msgstr "система пакунків вільна"

