msgstr "Показати або змінити параметр"

msgid "Show this help"
msgstr "Показати цю довідку"

msgid "Show the version"
msgstr "Показати версію"

msgid "Finishing the installation"
msgstr "Завершення встановлення"

msgid "Updating system packages"
msgstr "Оновлення системних пакунків"

msgid "Downloading updates"
msgstr "Завантаження оновлень"

msgid "Preparing the update"
msgstr "Підготовка оновлення"

msgid "Checking for updates"
msgstr "Пошук оновлень"

msgid "Cleaning up after the update"
msgstr "Прибирання після оновлення"

