msgstr "Lần chạy trước báo có vấn đề. Xem 'cachy-auto-update log'."

msgid "The last run was stopped before it finished."
msgstr "Lần chạy trước bị dừng trước khi xong."

msgid "The last run was cancelled. It will run again later."
msgstr "Lần chạy trước đã bị hủy. Nó sẽ chạy lại sau."

msgid "A restart is recommended to finish a kernel update."
msgstr "Nên khởi động lại để hoàn tất cập nhật kernel."

