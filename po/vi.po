msgstr "mỗi %d tuần"

msgid "The update was stopped before it finished."
msgstr "Bản cập nhật đã bị dừng trước khi xong."

msgid "Finishing an interrupted update"
msgstr "Đang hoàn tất bản cập nhật bị gián đoạn"

msgid "The last update was cut short, most likely because the machine was switched off. It is being finished now."
msgstr "Lần cập nhật trước bị ngắt giữa chừng, có lẽ do máy bị tắt. Giờ đang hoàn tất nó."

msgid "Package database locked"
msgstr "Cơ sở dữ liệu gói bị khóa"

msgid "pacman's lock file looks left over from an interrupted update. Updates are paused until it is cleared."
msgstr "Tệp khóa của pacman có vẻ còn sót lại từ một lần cập nhật bị gián đoạn. Việc cập nhật tạm dừng cho đến khi tệp được xóa."

msgid "Update failed"
msgstr "Cập nhật thất bại"

msgid "Something went wrong while updating. Run 'cachy-auto-update log' for details."
msgstr "Đã có lỗi khi cập nhật. Chạy 'cachy-auto-update log' để xem chi tiết."

msgid "Update stopped"
msgstr "Đã dừng cập nhật"

msgid "You can switch off the computer now. The update will run again later."
msgstr "Bạn có thể tắt máy ngay bây giờ. Việc cập nhật sẽ chạy lại sau."

msgid "System updated"
msgstr "Hệ thống đã được cập nhật"

#, c-format
msgid "%d updates were installed."
msgstr "Đã cài %d bản cập nhật."

msgid "Some packages were held back"
msgstr "Một số gói đã bị giữ lại"

#, c-format
msgid "%s could not be updated and was skipped. Everything else is up to date."
msgstr "Không thể cập nhật %s nên đã bỏ qua. Mọi thứ khác đều đã mới nhất."

msgid "This command has to run as root."
msgstr "Lệnh này phải chạy với quyền root."

msgid "Could not write the configuration file."
msgstr "Không thể ghi tệp cấu hình."

msgid "/etc/sudoers.d/cachy-auto-update is invalid; refusing to enable."
msgstr "/etc/sudoers.d/cachy-auto-update không hợp lệ; từ chối bật."

msgid "Could not enable the systemd timer."
msgstr "Không thể bật bộ hẹn giờ systemd."

msgid "Automatic updates are on."
msgstr "Cập nhật tự động đang bật."

msgid "No AUR helper found. Install paru or yay for AUR updates."
msgstr "Không tìm thấy trình hỗ trợ AUR. Hãy cài paru hoặc yay để cập nhật AUR."

msgid "base-devel is missing, so AUR packages cannot be built."
msgstr "Thiếu base-devel nên không thể biên dịch gói AUR."

msgid "Automatic updates are off."
msgstr "Cập nhật tự động đang tắt."

msgid "Notifications are on."
msgstr "Thông báo đang bật."

msgid "Notifications are off."
msgstr "Thông báo đang tắt."

msgid "Usage: cachy-auto-update notifications on|off"
msgstr "Cách dùng: cachy-auto-update notifications on|off"

msgid "Usage: cachy-auto-update config [list | get KEY | set KEY VALUE]"
msgstr "Cách dùng: cachy-auto-update config [list | get KHÓA | set KHÓA GIÁ_TRỊ]"

