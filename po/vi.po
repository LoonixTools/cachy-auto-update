msgstr "Việc cập nhật sẽ chờ đến khi máy được cắm sạc."

#, c-format
msgid "Updates wait below %d%% battery."
msgstr "Việc cập nhật sẽ chờ khi pin dưới %d%%."

msgid "Updates wait until it is closed."
msgstr "Việc cập nhật sẽ chờ đến khi nó được đóng."

msgid "No game running"
msgstr "Không có game nào đang chạy"

msgid "Updates wait so they do not get in the way."
msgstr "Việc cập nhật sẽ chờ để không làm phiền bạn."

msgid "Package system is free"
msgstr "Hệ thống gói đang rảnh"

msgid "Right now"
msgstr "Hiện tại"

msgid "An update waits while any of these is orange"
msgstr "Việc cập nhật sẽ chờ khi bất kỳ mục nào có màu cam"

msgid "System packages"
msgstr "Gói hệ thống"

msgid "AUR packages"
msgstr "Gói AUR"

msgid "Flatpaks"
msgstr "Flatpak"

msgid "AppImages"
msgstr "AppImage"

msgid "Last update"
msgstr "Lần cập nhật cuối"

msgid "When"
msgstr "Khi nào"

msgid "A check runs every hour and updates once the time below has passed."
msgstr "Mỗi giờ có một lần kiểm tra, và sẽ cập nhật khi đã qua khoảng thời gian bên dưới."

msgid "Wait while"
msgstr "Chờ khi"

msgid "Also while a video plays full screen. It tries again an hour later."
msgstr "Cả khi đang phát video toàn màn hình. Thử lại sau một giờ."

msgid "Minimum battery level"
msgstr "Mức pin tối thiểu"

msgid "Below this, a laptop on battery waits."
msgstr "Dưới mức này, máy tính xách tay dùng pin sẽ chờ."

msgid "No minimum"
msgstr "Không giới hạn"

msgid "Automatic"
msgstr "Tự động"

msgid "Save"
msgstr "Lưu"

msgid "For example: linux nvidia"
msgstr "Ví dụ: linux nvidia"

msgid "Sources"
msgstr "Nguồn"

msgid "Always updated, with pacman."
msgstr "Luôn được cập nhật, bằng pacman."

msgid "Always"
msgstr "Luôn luôn"

msgid "Built with paru or yay. One that does not build is held back."
msgstr "Được biên dịch bằng paru hoặc yay. Gói nào không biên dịch được sẽ bị giữ lại."

msgid "For the whole system and for each user."
msgstr "Cho toàn hệ thống và cho từng người dùng."

msgid "Through Gear Lever, while you are logged in."
msgstr "Qua Gear Lever, khi bạn đang đăng nhập."

msgid "AUR"
msgstr "AUR"

msgid "They rebuild often and break more often than released versions."
msgstr "Chúng được biên dịch lại thường xuyên và hay hỏng hơn các bản phát hành."

msgid "When a new package replaces an old one, say yes instead of stopping."
msgstr "Khi một gói mới thay thế gói cũ, trả lời có thay vì dừng lại."

msgid "Never update"
msgstr "Không bao giờ cập nhật"

msgid "Package names, separated by spaces."
msgstr "Tên gói, cách nhau bằng dấu cách."

msgid "Messages"
msgstr "Tin nhắn"

msgid "Show notifications"
msgstr "Hiện thông báo"

msgid "Turns off every message below."
msgstr "Tắt mọi tin nhắn bên dưới."

msgid "With a progress bar that has Pause and Cancel."
msgstr "Kèm thanh tiến trình có nút Tạm dừng và Hủy."

msgid "It waits in the notification area instead of popping up."
msgstr "Nó chờ ở vùng thông báo thay vì bật lên."

msgid "Desktop"
msgstr "Màn hình nền"

msgid "It shows when updates are waiting. A click opens this window."
msgstr "Nó hiện khi có bản cập nhật đang chờ. Bấm vào để mở cửa sổ này."

msgid "Its own tray icon and its daily check. Not needed while updates install by themselves."
msgstr "Biểu tượng khay và lần kiểm tra hằng ngày riêng. Không cần khi bản cập nhật tự cài."

msgid "It pops up in the middle of an update, so it is off."
msgstr "Nó bật lên giữa lúc cập nhật, nên đang tắt."

msgid "None"
msgstr "Không"

msgid "1 version"
msgstr "1 phiên bản"

#, c-format
msgid "%s versions"
msgstr "%s phiên bản"

msgid "After each update"
msgstr "Sau mỗi lần cập nhật"

msgid "Removes old package files. Installed software is never touched."
msgstr "Xóa các tệp gói cũ. Phần mềm đã cài không bao giờ bị động đến."

msgid "Cached versions to keep"
msgstr "Số phiên bản giữ trong bộ nhớ đệm"

msgid "More versions leave room to go back to an older one."
msgstr "Giữ nhiều phiên bản hơn để có thể quay về bản cũ."

msgid "Removes build leftovers of paru, yay and Shelly. The recipes stay."
msgstr "Xóa phần thừa sau biên dịch của paru, yay và Shelly. Công thức vẫn giữ lại."

msgid "This removes installed software, so it is off by default."
msgstr "Việc này gỡ phần mềm đã cài, nên mặc định tắt."

msgid "Last run"
msgstr "Lần chạy cuối"

msgid "All runs"
msgstr "Mọi lần chạy"

msgid "Which log"
msgstr "Nhật ký nào"

msgid "Restart"
msgstr "Khởi động lại"

msgid "Restart automatically"
msgstr "Tự động khởi động lại"

msgid "Only while nobody is logged in, and never after a failed update."
msgstr "Chỉ khi không ai đăng nhập, và không bao giờ sau một lần cập nhật thất bại."

msgid "Never"
msgstr "Không bao giờ"

msgid "After a kernel update"
msgstr "Sau khi cập nhật kernel"

msgid "After every update"
msgstr "Sau mỗi lần cập nhật"

msgid "A restart is planned to finish the update."
msgstr "Đã lên lịch khởi động lại để hoàn tất cập nhật."

msgid "It happens by itself once nobody is logged in."
msgstr "Nó sẽ tự diễn ra khi không ai đăng nhập."

#, c-format
msgid "This computer restarts in %d minutes to finish an update. To stop it, run: sudo shutdown -c"
msgstr "Máy này sẽ khởi động lại sau %d phút để hoàn tất cập nhật. Để dừng, chạy: sudo shutdown -c"

msgid "When to update"
msgstr "Khi nào cập nhật"

msgid "Updates only start in these hours. Update now works at any time."
msgstr "Việc cập nhật chỉ bắt đầu trong các giờ này. Cập nhật ngay dùng được mọi lúc."

msgid "Any time"
msgstr "Bất cứ lúc nào"

#, c-format
msgid "Between %s and %s"
msgstr "Từ %s đến %s"

msgid "Language of this window"
msgstr "Ngôn ngữ của cửa sổ này"

msgid "Just for you. Notifications follow the desktop."
msgstr "Chỉ cho bạn. Thông báo theo ngôn ngữ màn hình nền."

msgid "System default"
msgstr "Mặc định hệ thống"

msgid "Could not save the language."
msgstr "Không thể lưu ngôn ngữ."
