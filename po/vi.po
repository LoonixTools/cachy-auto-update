msgstr "Đang dừng cập nhật"

msgid "The current step is finished first. Please leave the computer switched on until then."
msgstr "Bước hiện tại sẽ được hoàn tất trước. Vui lòng để máy bật cho đến lúc đó."

msgid "Log"
msgstr "Nhật ký"

