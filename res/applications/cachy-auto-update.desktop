[Desktop Entry]
# The window. The same name labels the progress bar while an update runs:
# the desktop names a job by the entry its request names.
Type=Application
Name=CachyOS Auto-Update
Name[de]=CachyOS Auto-Update
GenericName=Automatic Updates
GenericName[de]=Automatische Updates
