[Desktop Entry]
# The window. The same name labels the progress bar while an update runs:
# the desktop names a job by the entry its request names.
Type=Application
Name=CachyOS Auto-Update
Name[de]=CachyOS Auto-Update
GenericName=Automatic Updates
GenericName[de]=Automatische Updates
GenericName[es]=Actualizaciones automáticas
GenericName[fr]=Mises à jour automatiques
GenericName[it]=Aggiornamenti automatici
GenericName[pt_BR]=Atualizações automáticas
GenericName[ru]=Автоматические обновления
GenericName[ja]=自動アップデート
GenericName[zh_CN]=自动更新
GenericName[ko]=자동 업데이트
Comment=Updates install by themselves in the background
Comment[de]=Updates installieren sich selbst im Hintergrund
Comment[es]=Las actualizaciones se instalan solas en segundo plano
Comment[fr]=Les mises à jour s'installent toutes seules en arrière-plan
Comment[it]=Gli aggiornamenti si installano da soli in background
Comment[pt_BR]=As atualizações se instalam sozinhas em segundo plano
Comment[ru]=Обновления ставятся сами в фоне
Comment[ja]=アップデートはバックグラウンドで自動的にインストールされます
Comment[zh_CN]=更新会在后台自动安装
Comment[ko]=업데이트가 백그라운드에서 저절로 설치됩니다
Exec=cachy-auto-update-gui
Icon=cachy-auto-update
Terminal=false
StartupWMClass=cachy-auto-update
Categories=System;PackageManager;
Keywords=update;upgrade;pacman;aur;flatpak;
Keywords[de]=Update;Aktualisierung;pacman;aur;flatpak;
Keywords[es]=actualización;actualizar;pacman;aur;flatpak;
Keywords[fr]=mise à jour;actualisation;pacman;aur;flatpak;
