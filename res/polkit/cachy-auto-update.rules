// Lets the person at the computer start an update from the tray icon without
// a password: Update now, Update and shut down, and Update and restart. Only
// these units, only "start", and only from a local session that is in front
// of the screen right now. Stopping them or changing anything else still asks
// as usual.
polkit.addRule(function (action, subject) {
	var units = [
		"cachy-auto-update-now.service",
		"cachy-auto-update-now@poweroff.service",
		"cachy-auto-update-now@reboot.service"
	];
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
	    units.indexOf(action.lookup("unit")) >= 0 &&
	    action.lookup("verb") == "start" &&
	    subject.local && subject.active) {
		return polkit.Result.YES;
	}
});
