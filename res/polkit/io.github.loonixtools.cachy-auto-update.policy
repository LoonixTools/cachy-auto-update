<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  The window changes settings with `pkexec cachy-auto-update config set`.
  That asks for the administrator password once and keeps it for a few
  minutes, so changing several settings asks only once.
-->
<policyconfig>
  <vendor>CachyOS Auto-Update</vendor>
  <vendor_url>https://github.com/LoonixTools/cachy-auto-update</vendor_url>
  <icon_name>cachy-auto-update</icon_name>
  <action id="io.github.loonixtools.cachy-auto-update.settings">
    <description>Change the update settings</description>
    <description xml:lang="de">Update-Einstellungen ändern</description>
    <description xml:lang="es">Cambiar los ajustes de actualización</description>
    <description xml:lang="fr">Modifier les paramètres de mise à jour</description>
    <description xml:lang="it">Modificare le impostazioni di aggiornamento</description>
    <description xml:lang="pt_BR">Alterar as configurações de atualização</description>
    <description xml:lang="ru">Изменить настройки обновлений</description>
    <description xml:lang="ja">アップデートの設定を変更</description>
    <description xml:lang="zh_CN">更改更新设置</description>
    <description xml:lang="ko">업데이트 설정 변경</description>
    <description xml:lang="pl">Zmień ustawienia aktualizacji</description>
    <description xml:lang="tr">Güncelleme ayarlarını değiştir</description>
    <description xml:lang="nl">De update-instellingen wijzigen</description>
    <description xml:lang="uk">Змінити налаштування оновлень</description>
    <description xml:lang="cs">Změnit nastavení aktualizací</description>
    <description xml:lang="sv">Ändra uppdateringsinställningarna</description>
    <description xml:lang="id">Ubah pengaturan pembaruan</description>
    <description xml:lang="vi">Thay đổi cài đặt cập nhật</description>
    <description xml:lang="hu">A frissítési beállítások módosítása</description>
    <description xml:lang="ro">Schimbă setările de actualizare</description>
    <message>Changing the settings of CachyOS Auto-Update needs your password.</message>
    <message xml:lang="de">Zum Ändern der Einstellungen von CachyOS Auto-Update wird Ihr Passwort benötigt.</message>
    <message xml:lang="es">Para cambiar los ajustes de CachyOS Auto-Update se necesita tu contraseña.</message>
    <message xml:lang="fr">La modification des paramètres de CachyOS Auto-Update nécessite votre mot de passe.</message>
    <message xml:lang="it">Per modificare le impostazioni di CachyOS Auto-Update serve la tua password.</message>
    <message xml:lang="pt_BR">Alterar as configurações do CachyOS Auto-Update requer sua senha.</message>
    <message xml:lang="ru">Для изменения настроек CachyOS Auto-Update нужен ваш пароль.</message>
    <message xml:lang="ja">CachyOS Auto-Update の設定を変更するにはパスワードが必要です。</message>
    <message xml:lang="zh_CN">更改 CachyOS Auto-Update 的设置需要你的密码。</message>
    <message xml:lang="ko">CachyOS Auto-Update 설정을 변경하려면 비밀번호가 필요합니다.</message>
    <message xml:lang="pl">Zmiana ustawień CachyOS Auto-Update wymaga twojego hasła.</message>
    <message xml:lang="tr">CachyOS Auto-Update ayarlarını değiştirmek için parolanız gerekiyor.</message>
    <message xml:lang="nl">Voor het wijzigen van de instellingen van CachyOS Auto-Update is je wachtwoord nodig.</message>
    <message xml:lang="uk">Для зміни налаштувань CachyOS Auto-Update потрібен ваш пароль.</message>
    <message xml:lang="cs">Ke změně nastavení CachyOS Auto-Update je potřeba vaše heslo.</message>
    <message xml:lang="sv">Ditt lösenord behövs för att ändra inställningarna för CachyOS Auto-Update.</message>
    <message xml:lang="id">Mengubah pengaturan CachyOS Auto-Update memerlukan kata sandi Anda.</message>
    <message xml:lang="vi">Cần mật khẩu của bạn để thay đổi cài đặt của CachyOS Auto-Update.</message>
    <message xml:lang="hu">A CachyOS Auto-Update beállításainak módosításához meg kell adnia a jelszavát.</message>
    <message xml:lang="ro">Pentru a schimba setările CachyOS Auto-Update este nevoie de parola ta.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/cachy-auto-update</annotate>
  </action>
</policyconfig>
